  {
    "id": "positive-submitAgentHeartbeat",
    "operationId": "submitAgentHeartbeat",
    "method": "POST",
    "path": "/api/v1/agents/{agentId}/heartbeat",
    "syntheticOnly": true,
    "secretHeaders": {
      "authorization": "ACCEPTANCE_API_AUTHORIZATION",
      "cookie": "ACCEPTANCE_VERCEL_SESSION"
    },
    "expectedStatuses": [
      201
    ],
    "bodyInput": "submitAgentHeartbeat",
    "contractRequirements": {
      "scopes": [
        "agents:verify"
      ],
      "parameters": [
        {
          "name": "agentId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "maxLength": 180
          }
        }
      ],
      "requestSchema": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent_id",
              "credential_id",
              "event_id",
              "issued_at",
              "environment",
              "authority_id",
              "policy_id",
              "policy_version",
              "signature"
            ],
            "properties": {
              "agent_id": {
                "type": "string"
              },
              "credential_id": {
                "type": "string"
              },
              "event_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{22,128}$"
              },
              "issued_at": {
                "type": "string",
                "format": "date-time",
                "description": "UTC ISO timestamp with milliseconds and Z suffix"
              },
              "environment": {
                "enum": [
                  "production",
                  "staging"
                ],
                "description": "Staging requires the explicit qualification flag and the pinned Staging database; Production behavior is unchanged."
              },
              "authority_id": {
                "type": "string"
              },
              "policy_id": {
                "type": "string"
              },
              "policy_version": {
                "type": "string"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{86}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "claims",
              "signature"
            ],
            "properties": {
              "mode": {
                "const": "swarm"
              },
              "signature": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{86}$"
              },
              "claims": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "domain",
                  "audience",
                  "tenantId",
                  "memberId",
                  "version",
                  "sequence",
                  "at"
                ],
                "properties": {
                  "domain": {
                    "const": "cyber-sentinels:swarm-heartbeat:v1"
                  },
                  "audience": {
                    "type": "string"
                  },
                  "tenantId": {
                    "type": "string"
                  },
                  "memberId": {
                    "type": "string"
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sequence": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "at": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
