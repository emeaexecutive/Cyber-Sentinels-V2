  {
    "id": "positive-openIncident",
    "operationId": "openIncident",
    "method": "POST",
    "path": "/api/v1/incidents",
    "syntheticOnly": true,
    "secretHeaders": {
      "authorization": "ACCEPTANCE_API_AUTHORIZATION",
      "cookie": "ACCEPTANCE_VERCEL_SESSION"
    },
    "expectedStatuses": [
      201
    ],
    "bodyInput": "openIncident",
    "contractRequirements": {
      "scopes": [
        "incidents:write"
      ],
      "parameters": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transaction_id",
          "summary",
          "observed_at"
        ],
        "properties": {
          "transaction_id": {
            "type": "string",
            "format": "uuid"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "description": "UTC ISO timestamp including milliseconds, ending Z."
          },
          "kind": {
            "const": "TRANSACTION_LINK"
          },
          "evidence_object_id": {
            "type": "string",
            "format": "uuid"
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider_account": {
                "type": "string",
                "maxLength": 200
              },
              "session": {
                "type": "string",
                "maxLength": 200
              },
              "api_tool": {
                "type": "string",
                "maxLength": 200
              },
              "model_service": {
                "type": "string",
                "maxLength": 200
              },
              "infrastructure": {
                "type": "string",
                "maxLength": 200
              },
              "credential_reference": {
                "type": "string",
                "maxLength": 200
              }
            }
          },
          "observed_purpose": {
            "type": "string",
            "maxLength": 1000
          },
          "outcome_layer": {
            "enum": [
              "provider",
              "runtime",
              "destination"
            ]
          },
          "outcome_status": {
            "enum": [
              "SUCCEEDED",
              "FAILED",
              "UNKNOWN"
            ]
          }
        },
        "dependentRequired": {
          "evidence_object_id": [
            "evidence_digest"
          ],
          "evidence_digest": [
            "evidence_object_id"
          ]
        },
        "allOf": [
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "not": {
                    "const": "TRANSACTION_LINK"
                  }
                }
              }
            },
            "then": {
              "required": [
                "evidence_object_id",
                "evidence_digest"
              ]
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "OUTCOME"
                }
              }
            },
            "then": {
              "required": [
                "outcome_layer",
                "outcome_status"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "outcome_layer"
                    ]
                  },
                  {
                    "required": [
                      "outcome_status"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "PURPOSE_OBSERVATION"
                }
              }
            },
            "then": {
              "required": [
                "observed_purpose"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "observed_purpose"
                ]
              }
            }
          }
        ]
      }
    }
  },
