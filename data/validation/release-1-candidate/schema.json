{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cybersentinels.com/schemas/release-validation-case-v1.json",
  "title": "Release 1 validation case",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseId", "datasetId", "datasetVersion", "entityType", "workflowType", "signalType", "evidenceMode", "evidenceReferences", "expectedDecision", "actualDecision", "groundTruthLabel", "reviewStatus", "reviewerId", "reviewerRole", "reviewTimestamp", "reviewerConfidence", "rationale", "provenance", "licenceBoundary", "limitations", "rulesetVersion", "providerVersions", "createdAt", "updatedAt"],
  "properties": {
    "caseId": { "type": "string", "minLength": 3 },
    "datasetId": { "type": "string", "minLength": 3 },
    "datasetVersion": { "type": "string", "minLength": 1 },
    "entityType": { "enum": ["human", "ai_agent", "machine_identity", "workflow"] },
    "workflowType": { "type": "string", "minLength": 1 },
    "signalType": { "type": "string", "minLength": 1 },
    "evidenceMode": { "enum": ["synthetic_fixture", "provider_sandbox", "consented_internal", "licensed_public_benchmark"] },
    "evidenceReferences": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "expectedDecision": { "enum": ["allow", "step_up", "review", "block", "abstain", "insufficient_evidence"] },
    "actualDecision": { "type": ["string", "null"] },
    "groundTruthLabel": { "type": ["string", "null"] },
    "reviewStatus": { "enum": ["pending", "reviewed", "disputed", "excluded", "approved"] },
    "reviewerId": { "type": ["string", "null"] },
    "reviewerRole": { "type": ["string", "null"] },
    "reviewTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "reviewerConfidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "rationale": { "type": ["string", "null"] },
    "provenance": { "type": "string", "minLength": 1 },
    "licenceBoundary": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "rulesetVersion": { "type": "string", "minLength": 1 },
    "providerVersions": { "type": "object", "additionalProperties": { "type": "string" } },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
