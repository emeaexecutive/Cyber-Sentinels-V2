# Executable safe-local Docker configuration. It contains no real credential.
# /api/health is expected to pass. /api/ready must truthfully report that the
# local Supabase/service-role dependency is unavailable until an approved,
# untracked non-Production env file is supplied.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

CYBER_SENTINELS_ENVIRONMENT=local
CYBER_SENTINELS_PUBLIC_ORIGIN=http://localhost:3000
SYNTHETIC_FIXTURES=false
SYNTHETIC_STAGING_PROJECT_REF=

NEXT_PUBLIC_SUPABASE_URL=http://host.docker.internal:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-docker-anon-key-not-a-credential
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_MODE=live
TURNSTILE_EXPECTED_HOSTNAME=

API_KEY_PEPPER=
API_KEY_ROTATION_SECRET=
API_EXECUTION_SIGNING_SECRET=

HOPAE_ENABLED=false
ML_RISK_ENABLED=false
ML_RISK_MODE=off
