NEXT_PUBLIC_SITE_URL=https://www.cybersentinels.com
NEXT_PUBLIC_APP_URL=https://www.cybersentinels.com
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
ENABLE_DEMO_SEED=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Optional explicit Preview-only use of Cloudflare's official testing pair.
# Set only on a Vercel Preview deployment together with both keys and the
# provider's fixed dummy response hostname. Production rejects this mode.
TURNSTILE_MODE=live
TURNSTILE_EXPECTED_HOSTNAME=
ADMIN_EMAILS=EMEAExecutive@icloud.com
ADMIN_ACCESS_CODE=change_this_secure_code

NEXT_PUBLIC_WORLD_APP_ID=app_staging_xxxxx
WORLD_ACTION=cyber-sentinels-verify
WORLD_RP_ID=cybersentinels

HOPAE_ENABLED=false
HOPAE_ENVIRONMENT=sandbox
HOPAE_CLIENT_ID=
HOPAE_CLIENT_SECRET=
HOPAE_WEBHOOK_SECRET=
HOPAE_PROVIDER_ID=
HOPAE_API_BASE_URL=https://sandbox.api.hopae.com
HOPAE_CONNECT_ISSUER=https://sandbox.connect.hopae.com
HOPAE_CALLBACK_TOLERANCE_SECONDS=300
HOPAE_REQUEST_TIMEOUT_MS=8000
HOPAE_MAX_RETRIES=2

# Optional server-to-server relay for persisted ALLOW decisions only.
# HTTPS is required outside local non-production testing. The shared secret
# signs the bounded request with HMAC-SHA256 and is never sent in the payload.
TRUST_ACTION_RELAY_URL=
TRUST_ACTION_RELAY_SECRET=

# Optional HMAC pepper for public API key digests. Existing 256-bit API
# secrets remain safely one-way hashed when this is not configured.
PUBLIC_API_KEY_PEPPER=
PUBLIC_API_EXECUTION_SIGNING_SECRET=
PUBLIC_API_WEBHOOK_URL=
PUBLIC_API_WEBHOOK_SECRET=

# Optional external Preview qualification credential. It only crosses Vercel
# Deployment Protection; Cyber Sentinels API authentication remains required.
# Never expose, log, screenshot, or commit a real value.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional exact HTTPS audience for native Operational Entity challenges.
# When unset, the authenticated request origin plus /native-verification is used.
NATIVE_VERIFICATION_AUDIENCE=

OPENAI_API_KEY=
ML_RISK_ENABLED=false
ML_RISK_MODE=off
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
